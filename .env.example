# Copy this to .env for local use with something like python-dotenv,
# or set these as real environment variables in Railway/Render's dashboard.

SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=yourapp.up.railway.app
CSRF_TRUSTED_ORIGINS=https://yourapp.up.railway.app

# Only needed if not using the platform's managed Postgres add-on
# (Railway/Render set DATABASE_URL automatically when you attach one).
# DATABASE_URL=postgres://user:password@host:5432/dbname
